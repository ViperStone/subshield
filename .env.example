# ============================================================
#  SubShield — Environment Variables
#  Copy this file to .env and fill in your values.
#  Lines marked [REQUIRED] must be set before going live.
#  Lines marked [OPTIONAL] enable premium features.
# ============================================================

# --- Database ---
# [REQUIRED] PostgreSQL connection string from Supabase/Render/Neon
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://subshield:YOUR_PASSWORD@localhost:5432/subshield

# --- Security ---
# [REQUIRED] Random 64-character string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING

# --- Environment ---
# Set to "production" for cloud deployments
ENVIRONMENT=production

# --- Frontend URL ---
# [REQUIRED] Your Vercel deployment URL (no trailing slash)
FRONTEND_URL=https://subshield.vercel.app

# --- AI Integration ---
# [OPTIONAL] OpenAI API key for AI-powered certificate parsing
# Without this, the heuristic fallback parser is used (still works, just less accurate)
OPENAI_API_KEY=sk-...

# --- Stripe Payments ---
# [OPTIONAL] Required for live billing. Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create these in Stripe Dashboard > Products
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...

# --- Email Outreach ---
# [OPTIONAL] Resend API key for email campaigns. Get from https://resend.com
RESEND_API_KEY=re_...

# --- SMS Notifications (future) ---
# [OPTIONAL] Twilio credentials for SMS certificate expiration alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
